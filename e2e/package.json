            "target": "build:local"
          }
        ]
      }
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
