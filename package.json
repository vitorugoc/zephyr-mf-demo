{
  "name": "zephyr-mf-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Platform Portal: a Module Federation micro-frontend app deployed with Zephyr Cloud",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nx run-many -t dev --parallel=5",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "deploy": "nx run-many -t build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "nx": "24.0.6",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "nx"
    ]
  }
}
